//
============================================================
//
//
Leaf, Voca/Redi via RA_LINK.
//

NEW RA_SORT_BASE
NEW RA_SORT_LEN
NEW RA_SORT_I
NEW RA_SORT_J
NEW RA_SORT_KEY
NEW RA_SORT_TMP
NEW RA_SORT_TMP2
NEW RA_SORT_ADDR

NOLINK
NOVA SORT_ENTRY Op=Move El1=C_1 Exit=RA_SORT_I
JEQ SORT_OUTER El1=RA_SORT_I El2=RA_SORT_LEN Exit=SORT_DONE
NOVA SORT_LOADKEY Op=Add El1=RA_SORT_BASE El2=RA_SORT_I Exit=RA_SORT_ADDR
NOVA SORT_READKEY Op=Read El1=RA_SORT_ADDR Exit=RA_SORT_KEY
NOVA SORT_INITJ Op=Sub El1=RA_SORT_I El2=C_1 Exit=RA_SORT_J

NOVA SORT_INNER Op=Less El1=RA_SORT_J El2=C_0 Exit=RA_FLAG
NOVA SORT_INNERJ Op=JumpIf El1=RA_FLAG Exit=SORT_INNER_DONE
NOVA SORT_LOAJ Op=Add El1=RA_SORT_BASE El2=RA_SORT_J Exit=RA_SORT_ADDR
NOVA SORT_READJ Op=Read El1=RA_SORT_ADDR Exit=RA_SORT_TMP
NOVA SORT_CMP Op=Less El1=RA_SORT_KEY El2=RA_SORT_TMP Exit=RA_FLAG
NOVA SORT_CMPJ Op=JumpIf El1=RA_FLAG Exit=SORT_INNER_BODY
NOVA SORT_CMPNO Op=Jump Exit=SORT_INNER_DONE

NOVA SORT_INNER_BODY Op=Add El1=RA_SORT_J El2=C_1 Exit=RA_SORT_TMP2
NOVA SORT_STOREUP Op=Add El1=RA_SORT_BASE El2=RA_SORT_TMP2 Exit=RA_SORT_ADDR
NOVA SORT_WRITE Op=Write El1=RA_SORT_ADDR El2=RA_SORT_TMP
NOVA SORT_DECJ Op=Sub El1=RA_SORT_J El2=C_1 Exit=RA_SORT_J
NOVA SORT_INNERLB Op=Jump Exit=SORT_INNER

NOVA SORT_INNER_DONE Op=Add El1=RA_SORT_J El2=C_1 Exit=RA_SORT_TMP2
NOVA SORT_FINAL_ADDR Op=Add El1=RA_SORT_BASE El2=RA_SORT_TMP2 Exit=RA_SORT_ADDR
NOVA SORT_WRITEKEY Op=Write El1=RA_SORT_ADDR El2=RA_SORT_KEY
NOVA SORT_OUTER_NEXT Op=Add El1=RA_SORT_I El2=C_1 Exit=RA_SORT_I
NOVA SORT_OUTERLB Op=Jump Exit=SORT_OUTER

RREDI SORT_DONE
